rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Only the law firm's single password-authenticated admin account
    // (username "admin" -> admin@amromansour-law.eg) is authorized.
    // Google Sign-In and all other accounts are rejected at the database level.
    function isFirmAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email == 'admin@amromansour-law.eg';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidStatusUpdate(data) {
      return data.status is string
        && data.status.size() > 0
        && data.status.size() <= 16
        && data.status in ['draft', 'approved', 'published'];
    }

    // External aggregator writes via Firebase Admin SDK (bypasses rules).
    // Only the authenticated "admin" user may read aggregator_content and update ONLY "status".
    match /aggregator_content/{docId} {
      allow get: if isFirmAdmin() && isValidId(docId);
      allow list: if isFirmAdmin();

      allow update: if isFirmAdmin()
        && isValidId(docId)
        && isValidStatusUpdate(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['status']);

      allow create, delete: if false;
    }
  }
}
